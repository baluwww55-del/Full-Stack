<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login webpage</title>
  </head>
  <style>
    body {
      font-family: Arial, Helvetica, sans-serif;
      background-color: rgb(234, 238, 241);
      margin: 0;
      padding: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .card {
      background: #dbe5e4;
      border-radius: 8px;
      width: 300px;
      padding: 30px;
    }
    h2 {
      color: black;
      margin-bottom: 20px;
      text-align: center;
    }
    form {
      display: flex;
      flex-direction: column;
      gap: 30px;
    }
    input {
      background-color: #efeaea;
      padding: 30;
      margin-bottom: 15px;
      border-radius: 8px;
    }
    button {
      padding: 10px;
      border-radius: 8px;
      background-color: #54e489;
    }
    button:hover {
      background-color: #05f449;
    }
  </style>

  <body>
    <div class="card">
      <h2>Welcome Back</h2>
      <form>
        <input type="email" name="" id="" placeholder="Enter you email" />
        <input type="password" name="" id="" placeholder="Enter you password" />
        <button>Sign up</button>
      </form>
    </div>
  </body>
</html>
